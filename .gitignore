# macOS
.DS_Store

# Logs
*.log
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache / emulator state
.firebase/

# Installer artifacts never live here — they are published as GitHub Release
# assets on ZinfaiAdmin/zinfai-download. Guard against an accidental copy.
*.pkg
*.exe
*.apk
*.dmg

# Raw retina screen captures (~20 MB of ~3400px originals). The optimised
# copies the site actually serves live in public/images/; keep the originals
# out of the repo so it doesn't carry both.
ZINFAI-SCREENSHOTS/

# Local env
.env
.env.local

# Node — the site itself still has no build step; this is the Cloud Functions
# backend that serves the gated downloads.
node_modules/
npm-debug.log*
functions/node_modules/
functions/.env
functions/.env.*
